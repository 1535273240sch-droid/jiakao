<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug 变体的网络安全配置（TASK 交付物 9）：
  - 放行 10.0.2.2（模拟器访问宿主机）、localhost / 127.0.0.1 的明文 HTTP；
  - 局域网明文：安卓的 domain-config 不能写 CIDR，联调常用的是任意局域网 IP，
    因此 debug 的 base-config 直接允许明文；release 不引用本文件（targetSdk 28+ 默认禁明文，仅 https）。
  用法：:app 的 debug 清单里加 android:networkSecurityConfig="@xml/network_security_config"
  （本文件位于 :core:update 的 debug 源集，会随 debug 变体合并进 :app）。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <!-- 调试期允许用户安装的 CA（便于抓包排查） -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
